import os
import numpy as np
import napari
from skimage import io, transform

# ============================================================
# CONFIGURACIÓN
# ============================================================
pixel_size          = 1.1364   
grosor_nominal      = 40       # µm entre cada posición Z (paso de 2 cortes)
indices_reales = [45, 46, 47, 48, 49, 51, 52, 54, 56, 57, 58, 60, 62, 63, 64, 67, 68, 69, 70, 71, 73]
ruta_raiz           = r"C:\Users\Frans\Desktop\ct2\RECONSTRUCCION_V1"
canales             = ["C00-DAPI", "C01-IBA-1", "C02-GFAP"]
colores             = ["blue",    "green",      "red"]
escala_reduccion    = 0.5

# ============================================================
# 1. CÁLCULO DE DIMENSIONES MÁXIMAS (Para evitar el fallo de 2000x2000)
# ============================================================
print("Detectando tamaño de las imágenes...")
max_h, max_w = 0, 0
for canal in canales:
    ruta_canal = os.path.join(ruta_raiz, canal)
    if not os.path.exists(ruta_canal): continue
    
    for f in os.listdir(ruta_canal):
        if f.endswith(".tif"):
            # Leemos solo los metadatos para ir rápido
            temp_img = io.imread(os.path.join(ruta_canal, f))
            h, w = temp_img.shape
            max_h = max(max_h, int(h * escala_reduccion))
            max_w = max(max_w, int(w * escala_reduccion))
            break # Con una foto por canal suele bastar si son iguales

print(f"Lienzo final calculado: {max_h} x {max_w}")

# ============================================================
# 2. CARGAR Y POSICIONAR CORTES
# ============================================================
z_min, z_max = min(indices_reales), max(indices_reales)
total_z_layers = (z_max - z_min) + 1 

viewer = napari.Viewer(ndisplay=3)

for canal, color in zip(canales, colores):
    ruta_canal = os.path.join(ruta_raiz, canal)
    if not os.path.exists(ruta_canal): continue

    # Creamos el volumen con el tamaño REAL detectado
    volume_3d = np.zeros((total_z_layers, max_h, max_w), dtype=np.uint16) 
    archivos_en_carpeta = os.listdir(ruta_canal)
    
    print(f"Procesando {canal}...")
    
    for n in indices_reales:
        # Buscamos archivos que empiecen por el número de los índices reales
        match = [f for f in archivos_en_carpeta if f.lower().startswith(f"c{n}") or f.startswith(str(n))]
        if not match: continue
        
        img = io.imread(os.path.join(ruta_canal, match[0]))
        img_res = transform.rescale(img, escala_reduccion, preserve_range=True, anti_aliasing=True).astype(np.uint16)
        
        z_pos = n - z_min
        
        # Ajuste de seguridad para el pegado
        h, w = img_res.shape
        # Pegamos la imagen centrada o desde la esquina (0,0) comprobando que no se salga
        h_limit = min(h, max_h)
        w_limit = min(w, max_w)
        volume_3d[z_pos, :h_limit, :w_limit] = img_res[:h_limit, :w_limit]
       
    
    # 1. ESCALA Z CORRECTA
    z_scale_factor = (grosor_nominal / pixel_size) / escala_reduccion

    # 2. AJUSTE ESTRATÉGICO DE BRILLOS 
    if canal == "C00-DAPI":
        limites = [0, 400] 
    elif canal == "C01-IBA-1":
        limites = [0, 300] 
    elif canal == "C02-GFAP":
        limites = [0, 150] 
    else:
        limites = [0, 1000]

    # 3. Aplicamos la visualización a Napari
    viewer.add_image(
        volume_3d,                
        name=canal,
        scale=(z_scale_factor, 1, 1),
        blending="additive", 
        colormap=color,
        contrast_limits=limites,
        opacity=0.6 if canal == "C02-GFAP" else 1.0
    )
    
# === FIN DEL BUCLE ===



print("\n¡Reconstruccion finalizada! Se muestra en el visor de Napari.")
napari.run()